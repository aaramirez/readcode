{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readcode.dev/schemas/search.schema.json",
  "title": "Search",
  "description": "Search index of a snapshot (snapshots/<sha>/search.json), written by `readcode validate`: one entry per block of every valid explain/<path>.json, so the viewer's Ctrl+K palette needs a single request instead of one per file.",
  "type": "array",
  "items": {
    "type": "object",
    "description": "An explained block.",
    "properties": {
      "path": {
        "$ref": "common.schema.json#/$defs/path",
        "description": "Explained file."
      },
      "blockId": {
        "type": "string",
        "pattern": "^b[0-9]+$",
        "description": "Block id within the file's explanation, e.g. b3."
      },
      "title": {
        "type": "string",
        "description": "Block title."
      },
      "range": {
        "$ref": "common.schema.json#/$defs/range",
        "description": "Block line range."
      }
    },
    "required": [
      "path",
      "blockId",
      "title",
      "range"
    ],
    "additionalProperties": false
  }
}
