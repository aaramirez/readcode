{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readcode.dev/schemas/links.schema.json",
  "title": "Links",
  "description": "Links root.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "sha": {
      "$ref": "common.schema.json#/$defs/sha40"
    },
    "docs": {
      "type": "object",
      "description": "Map from doc key (path of the markdown-bearing file relative to the snapshot dir, e.g. \"explain/app/main.py.json\", \"overview.md\", \"tours/login.json\", \"dirs/app.json\") to its markers. A tour's description uses \"tours/<id>.json\"; each tour step has its own key \"tours/<id>.json#<n>\" (n = 1-based step index), since steps resolve markers relative to their own file. Within one key a raw marker has a single resolution.",
      "additionalProperties": {
        "type": "array",
        "description": "Markers found in the doc.",
        "items": {
          "type": "object",
          "description": "A resolved marker.",
          "properties": {
            "raw": {
              "type": "string",
              "description": "Exact marker text, e.g. [[ref:app/x.py#f]]."
            },
            "kind": {
              "enum": [
                "symbol",
                "lines",
                "archify",
                "invalid"
              ],
              "description": "Marker kind."
            },
            "status": {
              "enum": [
                "exact",
                "ambiguous",
                "broken"
              ],
              "description": "Resolution status."
            },
            "target": {
              "$ref": "common.schema.json#/$defs/path",
              "description": "Resolved file path (exact)."
            },
            "range": {
              "$ref": "common.schema.json#/$defs/range",
              "description": "Resolved range (exact)."
            },
            "snapshot": {
              "enum": [
                "A",
                "B"
              ],
              "description": "Diff links only: snapshot the marker resolved against. Omitted means B; \"A\" means it only resolves in snapshot A (file, symbol or line range absent in B)."
            },
            "candidates": {
              "type": "array",
              "description": "Candidates when ambiguous.",
              "items": {
                "type": "object",
                "description": "A candidate.",
                "properties": {
                  "target": {
                    "$ref": "common.schema.json#/$defs/path"
                  },
                  "range": {
                    "$ref": "common.schema.json#/$defs/range"
                  }
                },
                "required": [
                  "target",
                  "range"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "raw",
            "kind",
            "status"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "sha",
    "docs"
  ],
  "additionalProperties": false
}
